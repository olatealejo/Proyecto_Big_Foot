rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function esAdmin() {
      return request.auth != null
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.rol == 'admin';
    }

    match /productos/{ruta=**} {
      allow read: if true;

      allow create, update: if esAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if esAdmin();
    }
  }
}
