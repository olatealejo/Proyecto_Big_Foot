rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == 'admin';
    }

    function esPropietario(autorId) {
      return estaAutenticado()
        && request.auth.uid == autorId;
    }

    match /usuarios/{usuarioId} {
      allow read: if estaAutenticado()
        && (
          request.auth.uid == usuarioId
          || esAdmin()
        );

      allow create: if estaAutenticado()
        && request.auth.uid == usuarioId
        && request.resource.data.rol == 'usuario';

      allow update: if esAdmin()
        || (
          estaAutenticado()
          && request.auth.uid == usuarioId
          && request.resource.data.rol == resource.data.rol
        );

      allow delete: if esAdmin()
        || (
          estaAutenticado()
          && request.auth.uid == usuarioId
        );
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    match /publicaciones/{publicacionId} {
      allow read: if true;

      allow create: if estaAutenticado()
        && request.resource.data.autorId == request.auth.uid;

      allow update: if esPropietario(resource.data.autorId)
        && request.resource.data.autorId == resource.data.autorId;

      allow delete: if esAdmin();
    }

    match /moderaciones/{moderacionId} {
      allow create, read: if esAdmin();
    }

    match /comentarios/{comentarioId} {
      allow read: if true;

      allow create: if estaAutenticado()
        && request.resource.data.autorId == request.auth.uid;

      allow update, delete: if esAdmin()
        || esPropietario(resource.data.autorId);
    }

    match /pedidos/{pedidoId} {
      allow create: if estaAutenticado()
        && request.resource.data.usuarioId == request.auth.uid;

      allow read, update, delete: if esAdmin()
        || esPropietario(resource.data.usuarioId);
    }
  }
}
